{
  "source": "Manual second transcription from QS48/49/50 code, independent of producer arrays; whitespace normalized only in comparison",
  "sourcePDFSHA256": "bfd415139913f156ea36b5de5f3d8a6fba7efd721b67c1be12ec45cc693df0dd",
  "program1": [
    "#include <stdio.h>",
    "#define InName \"sample.c\" /* 入力ファイル名 */",
    "int main() {",
    "FILE *infile;",
    "① int chr, i;",
    "long cnt;",
    "long freq[256]; /* freq[i]: 文字コードiの出現回数 */",
    "for (chr = 0; chr <= 255; chr++)",
    "freq[chr] = 0;",
    "infile = fopen(InName, \"rb\");",
    "cnt = 0;",
    "while ((chr = fgetc(infile)) != EOF) {",
    "cnt++;",
    "freq[chr]++;",
    "}",
    "printf(\" %10ld bytes processed\\n\\n\", ［a］);",
    "for (i = 0; i < 64; i++) {",
    "for (chr = i; chr <= ［b］; chr += ［c］) {",
    "if ((0x20 <= chr) && (chr <= 0x7E))",
    "printf(\" %10ld %02X '%c'\", freq[chr], chr, chr);",
    "else",
    "printf(\" %10ld %02X    \", freq[chr], chr);",
    "}",
    "printf(\"\\n\");",
    "}",
    "②",
    "}"
  ],
  "declaration": [
    "int ih, ix, code[256];"
  ],
  "sort": [
    "for (i = 0; i <= 255; i++)",
    "code[i] = i;",
    "③ ih = 255;",
    "④ while (ih > 0) {",
    "⑤ for (i = 0; i < ih; i++) {",
    "⑥ if (freq[i] < freq[i+1]) {",
    "Swap(code[i], code[i+1]);",
    "Swap(freq[i], freq[i+1]);",
    "⑦",
    "}",
    "}",
    "⑧ ih--;",
    "}",
    "printf(\"\\n\");",
    "for (i = 0; i < 64; i++) {",
    "for (chr = i; chr <= ［b］; chr += ［c］) {",
    "if ((0x20 <= code[chr]) && (code[chr] <= 0x7E))",
    "printf(\" %10ld %02X '%c'\", freq[chr], code[chr], code[chr]);",
    "else",
    "printf(\" %10ld %02X    \", freq[chr], code[chr]);",
    "}",
    "printf(\"\\n\");",
    "}"
  ]
}
