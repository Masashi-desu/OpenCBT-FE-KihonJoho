    },
    {
      "number": 41,
      "page": 54,
      "text": "         INPUT  PROCEDURE IS REL-PROC"
    },
    {
      "number": 42,
      "page": 54,
      "text": "         OUTPUT PROCEDURE IS RET-PROC."
    },
    {
      "number": 43,
      "page": 54,
      "text": "    CLOSE RSL-FILE PRT-FILE."
    },
    {
      "number": 44,
      "page": 54,
      "text": "    STOP RUN."
    },
    {
      "number": 45,
      "page": 54,
      "text": "REL-PROC."
    },
    {
      "number": 46,
      "page": 54,
      "text": "    PERFORM UNTIL RSL-EOF"
    },
    {
      "number": 47,
      "page": 54,
      "text": "        READ RSL-FILE AT END     SET RSL-EOF TO TRUE"
    },
    {
      "number": 48,
      "page": 54,
      "text": "                     NOT AT END PERFORM CALC-PROC"
    },
    {
      "number": 49,
      "page": 54,
      "text": "        END-READ"
    },
    {
      "number": 50,
      "page": 54,
      "text": "    END-PERFORM."
    },
    {
      "number": 51,
      "page": 54,
      "text": "CALC-PROC."
    },
    {
      "number": 52,
      "page": 54,
      "text": "    MOVE RSL-NO  TO SRT-NO."
    },
    {
      "number": 53,
      "page": 54,
      "text": "    MOVE RSL-BLD TO SRT-BLD."
    },
    {
      "number": 54,
      "page": 54,
      "text": "    COMPUTE SRT-TOTAL = RSL-SCR(1) + RSL-SCR(2) +"
    },
    {
      "number": 55,
      "page": 54,
      "text": "        RSL-SCR(3) + RSL-SCR(4) + RSL-SCR(5)."
    },
    {
      "number": 56,
      "page": 54,
      "text": "    RELEASE SRT-REC."
    },
    {
      "number": 57,
      "page": 54,
      "text": "RET-PROC."
    },
    {
      "number": 58,
      "page": 54,
      "text": "    PERFORM UNTIL SRT-EOF"
    },
    {
      "number": 59,
      "page": 54,
      "text": "        RETURN SRT-FILE AT END     SET SRT-EOF TO TRUE"
    },
    {
      "number": 60,
      "page": 54,
      "text": "                       NOT AT END PERFORM PRT-PROC"
    },
    {
      "number": 61,
      "page": 55,
      "text": "        END-RETURN"
    },
    {
      "number": 62,
      "page": 55,
      "text": "    END-PERFORM."
    },
    {
      "number": 63,
      "page": 55,
      "text": "PRT-PROC."
    },
    {
      "number": 64,
      "page": 55,
      "text": "    [b]"
    },
    {
      "number": 65,
      "page": 55,
      "text": "    IF SRT-TOTAL < ALL-CR-TOTAL THEN"
    },
    {
      "number": 66,
      "page": 55,
      "text": "        MOVE SRT-TOTAL TO ALL-CR-TOTAL"
    },
    {
      "number": 67,
      "page": 55,
      "text": "        [c]"
    },
    {
      "number": 68,
      "page": 55,
      "text": "    END-IF."
    },
    {
      "number": 69,
      "page": 55,
      "text": "    IF SRT-TOTAL < BLD-CR-TOTAL(SRT-BLD) THEN"
    },
    {
      "number": 70,
      "page": 55,
      "text": "        MOVE SRT-TOTAL TO BLD-CR-TOTAL(SRT-BLD)"
    },
    {
      "number": 71,
      "page": 55,
      "text": "        [d]"
    },
    {
      "number": 72,
      "page": 55,
      "text": "    END-IF."
    },
    {
      "number": 73,
      "page": 55,
      "text": "    INITIALIZE PRT-REC."
    },
    {
      "number": 74,
      "page": 55,
      "text": "    MOVE ALL-RANK          TO PRT-ALL-RANK."
    },
    {
      "number": 75,
      "page": 55,
      "text": "    MOVE SRT-NO            TO PRT-NO."
    },
    {
      "number": 76,
      "page": 55,
      "text": "    MOVE SRT-BLD           TO PRT-BLD."
    },
    {
      "number": 77,
      "page": 55,
      "text": "    MOVE BLD-RANK(SRT-BLD)  TO PRT-BLD-RANK."
    },
    {
      "number": 78,
      "page": 55,
      "text": "    MOVE SRT-TOTAL         TO PRT-TOTAL."
    },
    {
      "number": 79,
      "page": 55,
      "text": "    WRITE PRT-REC."
    }
