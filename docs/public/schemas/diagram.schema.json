              "description": "開発側の固定描画規則の識別子。値の意味・範囲・個数を登録契約で検査する。",
              "$comment": "必須：未登録・null・省略を拒否する。"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000,
                "description": "登録プロファイルの入力値。実行する命令として解釈しない。",
                "$comment": "要素：nullや穴を拒否する。"
              },
              "description": "登録順に図の値と構造を確定する入力列。図単独で再抽選しない。",
              "$comment": "必須：個数・範囲を検査する。"
            }
          },
          "required": [
            "kind",
            "profile",
            "values"
          ],
          "description": "固定描画器へ渡す宣言的な図の入力値。"
        }
      ],
      "description": "配列、フローチャート、グラフ又は登録した原形式図プロファイルの構造。許可した値だけで構成し、コード・スタイル・イベントを含めない。",
      "$comment": "必須：欠落を拒否する。参照値や既定値で補完しない。"
    },
    "captionPresentation": {
      "$ref": "https://opencbt-fe-kihonjoho.example/schemas/3.0.0/common.schema.json#/$defs/captionPresentation",
      "description": "図表のcaptionを可視題として表示するか、読み上げ用の意味名として保持するかを指定する。",
      "$comment": "任意：省略時はcaptionを従来どおり可視にする。accessibleでも必須のcaptionを空にせず、原の識別子・題・単位が別表示で必要ならsourceLabelsを併記する。"
    },
    "sourceLabels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "https://opencbt-fe-kihonjoho.example/schemas/3.0.0/common.schema.json#/$defs/sourceLabel",
        "description": "字面と位置を原資料で照合した可視ラベル1件。",
        "$comment": "配列要素：textとpositionを必須とし、未知フィールドと同一要素の重複を拒否する。"
      },
      "description": "読み上げ用のcaptionとは別に可視保持する、原資料で確認した識別子・題・単位注記。",
      "$comment": "条件付き：captionPresentationがaccessibleの場合だけ指定できる。省略時は別ラベルを作らず、指定する場合は1〜4件でtextとpositionを省略しない。"
    }
  },
  "required": [
    "type",
    "id",
    "rendererRef",
    "caption",
    "alt",
    "attribution",
    "scene"
  ],
  "description": "管理された描画器へ渡す表示専用の図構造。図素材の出典・条件を保持し、任意コード、解答操作、経路実行をデータに含めない。",
  "dependentSchemas": {
    "sourceLabels": {
      "properties": {
        "captionPresentation": {
          "const": "accessible",
          "description": "図表のcaptionを可視題として表示するか、読み上げ用の意味名として保持するかを指定する。",
          "$comment": "任意：省略時はcaptionを従来どおり可視にする。accessibleでも必須のcaptionを空にせず、原の識別子・題・単位が別表示で必要ならsourceLabelsを併記する。"
        }
      },
      "required": [
        "captionPresentation"
      ]
    }
  }
}
