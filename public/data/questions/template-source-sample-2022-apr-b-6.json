    {
      "id": "context-generated-1",
      "title": "A社のECサイトと委託契約",
      "content": {
        "attribution": {
          "origin": "adapted",
          "sourceRefs": [
            {
              "sourceId": "source-ipa-sample-2022-apr-b-qs",
              "locator": {
