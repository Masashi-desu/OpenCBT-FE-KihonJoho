        "blocks": [
          {
            "type": "paragraph",
            "text": "PC費の実績は，2016年度の前年度に対する増分よりも，2017年度の前年度に対する増分の方が小さい。"
          }
        ]
      }
    },
    {
      "id": "choice-original-4",
      "content": {
        "attribution": {
          "origin": "official",
          "sourceRefs": [
