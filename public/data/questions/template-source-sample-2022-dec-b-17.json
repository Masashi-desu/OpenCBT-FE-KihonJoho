                "period": "2022年12月公表 サンプル問題",
                "subject": "科目B",
                "questionNumber": "17"
              }
            }
          ],
          "rightsRefs": [
            "rights-ipa-sample-2022-dec-b",
            "rights-original"
          ],
          "creatorIds": [
            "codex"
          ]
        },
        "blocks": [
          {
            "type": "paragraph",
            "text": "項番1 アプリケーションサーバのOSに既知の脆弱性があり、攻撃を受けるおそれがある。"
          },
          {
            "type": "paragraph",
            "text": "項番2 Aサイトにクロスサイトスクリプティングの脆弱性があり、会員情報を不正に取得されるおそれがある。"
          },
          {
            "type": "paragraph",
            "text": "項番3 Aサイトで利用しているDBMSに既知の脆弱性があり、攻撃を受けるおそれがある。"
          }
        ]
      }
    }
  ],
